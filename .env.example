# Copy to .env.local for local development, and set the same two values as
# Environment Variables in the Vercel project.
#
# Both are safe to expose in the browser. The anon key is designed to be
# public: it grants no access on its own, because every table is locked behind
# row level security policies that match auth.uid() to the row owner.
#
# Never put the service_role key or the database password in here. Those
# bypass row level security entirely.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
